@Transport.Api_HostAddress = http://localhost:5268

GET {{Transport.Api_HostAddress}}/health/ready
Accept: application/json

###

GET {{Transport.Api_HostAddress}}/api/auth/csrf
Accept: application/json

###

GET {{Transport.Api_HostAddress}}/api/auth/me
Accept: application/json

###

GET {{Transport.Api_HostAddress}}/api/admin/roles
Accept: application/json

###

GET {{Transport.Api_HostAddress}}/api/admin/users
Accept: application/json

###

GET {{Transport.Api_HostAddress}}/api/admin/audit
Accept: application/json

###

GET {{Transport.Api_HostAddress}}/api/stops
Accept: application/json

###

POST {{Transport.Api_HostAddress}}/api/stops
Content-Type: application/json
X-CSRF-TOKEN: {{CsrfToken}}

{
  "name": "Merkez Meydan",
  "code": "MRK-001",
  "description": "Ana meydan durağı",
  "color": "#13B8A6",
  "longitude": 32.8597,
  "latitude": 39.9334
}

###

PUT {{Transport.Api_HostAddress}}/api/stops/{{StopId}}
Content-Type: application/json
X-CSRF-TOKEN: {{CsrfToken}}

{
  "name": "Merkez Meydan Güncel",
  "code": "MRK-001",
  "description": "Güncellenmiş durak",
  "color": "#F6B84A",
  "longitude": 32.8598,
  "latitude": 39.9335,
  "version": 1
}

###

POST {{Transport.Api_HostAddress}}/api/stops/{{StopId}}/archive
Content-Type: application/json
X-CSRF-TOKEN: {{CsrfToken}}

{
  "version": 2
}

###

POST {{Transport.Api_HostAddress}}/api/admin/users
Content-Type: application/json
X-CSRF-TOKEN: {{CsrfToken}}

{
  "email": "operator@example.com",
  "displayName": "Example Operator",
  "password": "Strong-Password-2026!",
  "roles": ["Operator"]
}

###

PUT {{Transport.Api_HostAddress}}/api/admin/users/{{UserId}}/roles
Content-Type: application/json
X-CSRF-TOKEN: {{CsrfToken}}

{
  "roles": ["User"]
}

###
